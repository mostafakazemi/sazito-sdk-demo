SAZITO_STORE_DOMAIN=testmosi.sazito.com
STOREFRONT_URL=https://testmosi.sazito.com
SAZITO_REVALIDATE_SECRET=replace-with-at-least-32-random-characters

# Use local mock responses for server and browser SDK calls
SAZITO_USE_MOCKS=false
NEXT_PUBLIC_SAZITO_USE_MOCKS=false
# Simulated response latency in milliseconds; 0 disables the delay
SAZITO_MOCK_DELAY_MS=500
NEXT_PUBLIC_SAZITO_MOCK_DELAY_MS=500
SAZITO_DEBUG=false
NEXT_PUBLIC_SAZITO_DEBUG=false

# Optional credentials for authenticated, read-only live SDK tests
SAZITO_LIVE_TEST_EMAIL=
SAZITO_LIVE_TEST_PASSWORD=
